<!DOCTYPE html>
<html lang="en">
<head>
<title>Messages</title>
</head>
<body>
<p>Tytuly:</p> <!-- oczekiwanie na dane -->
    <table id="titleList">
        <% for (let i = 0; i < messages.length; i++) { %>  
         <tr>
            <td><%= messages[i].title%></td>
            <td><%= messages[i].author %></td>
            <td>
                <button onclick="deleteBook('<%= messages[i]._id %>')">Usuń</button>
                <button onclick="updateBook('<%= messages[i]._id %>')">Edytuj</button>
            </td>
        </tr>

        </li> <!-- Output the current number -->  
        <% } %> 
    </table>

<p>Nowy tytul: </p>
    <input type="text" id="title" name="title">
    <input type="text" id="author" name="author">
    <button onclick="addBook">Dodaj</button>
</body>
</html>