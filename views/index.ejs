<!DOCTYPE html>
<html lang="en">
<head>
<title>Messages</title>
</head>
<body>
<p>Tytuly:</p> <!-- oczekiwanie na dane -->
    <ul id="titleList">
        <% for (let i = 0; i < messages.length; i++) { %>  
         <li>
            <%= messages[i].title%> - <%= messages[i].author %> 
            <form action="/delete" method="post">
                <button type="submit" name="_id" value="<%= messages[i]._id%>">Usuń</button>
            </form>

            <a href="/update/<%= messages[i]._id %>">Popraw</a>

        </li> <!-- Output the current number -->  
        <% } %> 
    </ul>

